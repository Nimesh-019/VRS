
<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Book Vehicle</title>

    <link rel="stylesheet" href="/css/booking.css">
</head>


<body>


    <div class="container">

        <div class="card">


            <!-- ================= VEHICLE IMAGE ================= -->

            <div class="vehicle-image">

                <% if (vehicle.image) { %>

                    <img
                        src="<%= vehicle.image %>"
                        alt="<%= vehicle.brand %> <%= vehicle.model %>"
                    >

                <% } else { %>

                    <div class="no-image">
                        No Image Available
                    </div>

                <% } %>

            </div>


            <div class="content">


                <h1>
                    Book Vehicle
                </h1>


                <!-- ================= VEHICLE INFORMATION ================= -->

                <div class="vehicle-info">


                    <div class="vehicle-heading">

                        <h2>

                            <%= vehicle.brand %>
                            <%= vehicle.model %>

                        </h2>


                        <span class="vehicle-type">

                            <%= vehicle.type || 'Vehicle' %>

                        </span>

                    </div>


                    <% if (vehicle.vehicleNumber) { %>

                        <p>

                            <strong>
                                Registration:
                            </strong>

                            <%= vehicle.vehicleNumber %>

                        </p>

                    <% } %>


                    <p class="price">

                        ₹<%= vehicle.pricePerDay %>

                        <span>
                            / day
                        </span>

                    </p>


                    <p>

                        <strong>
                            Status:
                        </strong>


                        <% if (vehicle.availability) { %>

                            <span class="available">
                                Available
                            </span>

                        <% } else { %>

                            <span class="unavailable">
                                Currently Rented
                            </span>

                        <% } %>

                    </p>


                </div>


                <!-- ================= BOOKING FORM ================= -->

                <form
                    action="/book/<%= vehicle._id %>"
                    method="POST"
                >


                    <div class="date-group">

                        <label for="startDate">
                            Start Date
                        </label>

                        <input
                            type="date"
                            name="startDate"
                            id="startDate"
                            min="<%= new Date().toISOString().split('T')[0] %>"
                            required
                        >

                    </div>


                    <div class="date-group">

                        <label for="endDate">
                            End Date
                        </label>

                        <input
                            type="date"
                            name="endDate"
                            id="endDate"
                            min="<%= new Date().toISOString().split('T')[0] %>"
                            required
                        >

                    </div>


                    <div class="actions">

                        <button
                            type="submit"
                            class="btn btn-primary"
                        >
                            Confirm Booking
                        </button>


                        <a
                            href="/user/dashboard"
                            class="btn btn-secondary"
                        >
                            Cancel
                        </a>

                    </div>


                </form>


            </div>

        </div>

    </div>


</body>

</html>
