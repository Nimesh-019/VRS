<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Report Complaint - Vehicle Rental System
    </title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <!-- ================= HEADER ================= -->

    <header>

        <h1>

            <span>V</span>RS - Vehicle Rentals

        </h1>

        <div class="user-nav">

            <span>

                Welcome,

                <strong>
                    <%= user.name %>
                </strong>

                (Customer)

            </span>

            <a
                href="/user/dashboard"
                class="home-btn"
            >
                Home
            </a>

            <a
                href="/bookings"
                class="home-btn"
            >
                My Bookings
            </a>

            <a
                href="/complaints"
                class="home-btn"
            >
                My Complaints
            </a>

            <a
                href="/logout"
                class="logout-btn"
            >
                Logout
            </a>

        </div>

    </header>

    <!-- ================= MAIN ================= -->

    <div class="container">

        <!-- ================= PAGE HEADER ================= -->

        <div class="section-header">

            <div>

                <h2>
                    Report Complaint
                </h2>

                <p>
                    Submit a complaint for any of your rental bookings.
                </p>

            </div>

            <a
                href="/bookings"
                class="reset-btn"
            >
                ← Back to Bookings
            </a>

        </div>

        <!-- ================= COMPLAINT FORM ================= -->

        <div class="auth-wrapper" style="padding: 20px 0;">

            <div class="auth-card" style="max-width: 600px;">

                <h3 style="font-size: 18px; margin: 0 0 15px 0; color: #0f172a; padding-bottom: 12px; border-bottom: 1px solid #e2e8f0;">
                    File a Complaint
                </h3>

                <% if (typeof error !== 'undefined' && error) { %>

                    <div class="alert-error">

                        <%= error %>

                    </div>

                <% } %>

                <form
                    action="/complaint"
                    method="POST"
                >

                    <!-- SELECT BOOKING -->

                    <div class="form-group">

                        <label for="bookingId">
                            Select Rental Booking
                        </label>

                        <% if (typeof bookings !== 'undefined' && bookings && bookings.length > 0) { %>

                            <select
                                name="bookingId"
                                id="bookingId"
                                required
                            >

                                <% bookings.forEach(b => { %>

                                    <option
                                        value="<%= b._id %>"
                                        <%= (typeof booking !== 'undefined' && booking && booking._id.toString() === b._id.toString()) ? 'selected' : '' %>
                                    >
                                        <%= b.vehicleId ? (b.vehicleId.brand + ' ' + b.vehicleId.model) : 'Vehicle' %>
                                        (<%= b.vehicleId ? b.vehicleId.vehicleNumber : 'N/A' %>) -
                                        <%= new Date(b.startDate).toLocaleDateString() %> [<%= b.status.toUpperCase() %>]
                                    </option>

                                <% }) %>

                            </select>

                        <% } else if (typeof booking !== 'undefined' && booking) { %>

                            <input
                                type="hidden"
                                name="bookingId"
                                value="<%= booking._id %>"
                            >

                            <input
                                type="text"
                                readonly
                                value="<%= vehicle ? (vehicle.brand + ' ' + vehicle.model) : 'Vehicle' %> (<%= new Date(booking.startDate).toLocaleDateString() %>)"
                            >

                        <% } else { %>

                            <p style="color: #ef4444; font-size: 14px; margin-top: 5px;">
                                You don't have any bookings to report a complaint for.
                            </p>

                        <% } %>

                    </div>

                    <!-- SUBJECT -->

                    <div class="form-group">

                        <label for="subject">
                            Complaint Subject
                        </label>

                        <input
                            type="text"
                            id="subject"
                            name="subject"
                            required
                            placeholder="e.g. Vehicle condition / cleanliness / billing / delay"
                        >

                    </div>

                    <!-- MESSAGE -->

                    <div class="form-group">

                        <label for="message">
                            Detailed Description
                        </label>

                        <textarea
                            id="message"
                            name="message"
                            required
                            rows="5"
                            placeholder="Please describe your complaint in detail..."
                        ></textarea>

                    </div>

                    <!-- ACTIONS -->

                    <div style="display: flex; gap: 12px; margin-top: 25px;">

                        <button
                            type="submit"
                            class="btn"
                            style="flex: 1;"
                            <%= (typeof bookings !== 'undefined' && bookings && bookings.length === 0 && !booking) ? 'disabled' : '' %>
                        >
                            Submit Complaint
                        </button>

                        <a
                            href="/bookings"
                            class="reset-btn"
                        >
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</body>

</html>