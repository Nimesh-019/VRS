<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        My Bookings - Vehicle Rental System
    </title>

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>


    <!-- ================= HEADER ================= -->

    <header>

        <h1>

            <span>V</span>RS - Vehicle Rentals

        </h1>


        <div class="user-nav">

            <span>

                Welcome,

                <strong>
                    <%= user.name %>
                </strong>

                (Customer)

            </span>


            <a href="/bookings" class="bookings-btn">
                My Bookings
            </a>

            <a href="/complaints" class="bookings-btn">
                My Complaints
            </a>


            <a href="/logout" class="logout-btn">
                Logout
            </a>

        </div>

    </header>



    <!-- ================= MAIN ================= -->

    <div class="container">


        <!-- ================= PAGE HEADER ================= -->

        <div class="section-header">

            <div>

                <h2>
                    My Bookings
                </h2>

                <p>
                    View and manage your vehicle rental bookings.
                </p>

            </div>


            <div style="display: flex; gap: 10px;">
                <a href="/complaint" class="btn">
                    Report a Complaint
                </a>

                <a href="/complaints" class="reset-btn">
                    My Complaints
                </a>

                <a href="/user/dashboard" class="home-btn">
                    Go Home
                </a>
            </div>

        </div>


        <!-- ================= MESSAGES ================= -->

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success" style="background-color: #d1fae5; color: #065f46; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #a7f3d0; font-weight: 500;">
                <%= success %>
            </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger" style="background-color: #fee2e2; color: #991b1b; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #fca5a5; font-weight: 500;">
                <%= error %>
            </div>
        <% } %>



        <!-- ================= FILTER ================= -->

        <div class="filter-box">

            <form action="/bookings" method="GET" class="filter-form">


                <!-- BOOKING STATUS -->

                <select name="status">

                    <option value="">
                        All Booking Status
                    </option>


                    <option value="pending" <%=status==='pending' ? 'selected' : '' %>>
                        Pending
                    </option>

                    <option value="confirmed" <%=status==='confirmed' ? 'selected' : '' %>>
                        Confirmed
                    </option>

                    <option value="ongoing" <%=status==='ongoing' ? 'selected' : '' %>>
                        Ongoing
                    </option>

                    <option value="completed" <%=status==='completed' ? 'selected' : '' %>>
                        Completed
                    </option>

                    <option value="rejected" <%=status==='rejected' ? 'selected' : '' %>>
                        Rejected
                    </option>

                    <option value="cancelled" <%=status==='cancelled' ? 'selected' : '' %>>
                        Cancelled
                    </option>

                    <option value="expired" <%=status==='expired' ? 'selected' : '' %>>
                        Expired
                    </option>

                </select>



                <!-- VEHICLE TYPE -->

                <select name="type">

                    <option value="">
                        All Vehicle Types
                    </option>


                    <option value="Car" <%=type==='Car' ? 'selected' : '' %>
                        >
                        Car
                    </option>


                    <option value="Bike" <%=type==='Bike' ? 'selected' : '' %>
                        >
                        Bike
                    </option>


                    <option value="Scooter" <%=type==='Scooter' ? 'selected' : '' %>
                        >
                        Scooter
                    </option>


                    <option value="SUV" <%=type==='SUV' ? 'selected' : '' %>
                        >
                        SUV
                    </option>


                    <option value="Other" <%=type==='Other' ? 'selected' : '' %>
                        >
                        Other
                    </option>

                </select>



                <!-- FILTER BUTTON -->

                <button type="submit" class="filter-btn">
                    Filter
                </button>



                <!-- CLEAR -->

                <a href="/bookings" class="clear-filter-btn">
                    Clear
                </a>

            </form>

        </div>



        <!-- ================= RESULTS ================= -->

        <% if (bookings && bookings.length> 0) { %>

            <div class="results-info">

                Showing

                <strong>
                    <%= bookings.length %>
                </strong>

                booking<%= bookings.length===1 ? '' : 's' %>

            </div>

            <% } %>



                <!-- ================= BOOKINGS ================= -->

                <% if (bookings && bookings.length> 0) { %>


                    <div class="booking-grid">


                        <% bookings.forEach(booking => { %>
                            <div class="booking-record-card">
                                <!-- HEADER -->
                                <div class="record-header">
                                    <div class="record-title-box">
                                        <div class="record-title">
                                            <%= booking.vehicleId ? `${booking.vehicleId.brand || ''} ${booking.vehicleId.model || ''}`.trim() : 'Vehicle' %>
                                            <% if (booking.vehicleId && booking.vehicleId.type) { %>
                                                <span class="record-type-badge"><%= booking.vehicleId.type %></span>
                                            <% } %>
                                        </div>
                                        <div class="record-subtitle">
                                            Reg No: <strong><%= booking.vehicleId ? (booking.vehicleId.vehicleNumber || 'N/A') : 'N/A' %></strong>
                                        </div>
                                    </div>

                                    <div class="record-badges">
                                        <% if (booking.status === 'pending') { %>
                                            <span class="status pending">🟡 Pending approval</span>
                                        <% } else if (booking.status === 'confirmed') { %>
                                            <span class="status confirmed">🔵 Confirmed</span>
                                        <% } else if (booking.status === 'ongoing') { %>
                                            <span class="status ongoing">🟢 Ongoing</span>
                                        <% } else if (booking.status === 'completed') { %>
                                            <span class="status completed">⚪ Completed</span>
                                        <% } else if (booking.status === 'rejected') { %>
                                            <span class="status rejected">🔴 Rejected</span>
                                        <% } else if (booking.status === 'cancelled') { %>
                                            <span class="status cancelled">⚫ Cancelled</span>
                                        <% } else if (booking.status === 'expired') { %>
                                            <span class="status expired">🟠 Expired</span>
                                        <% } else { %>
                                            <span class="status pending">🟡 <%= (booking.status || 'pending').toUpperCase() %></span>
                                        <% } %>

                                        <% if (booking.paymentStatus === 'paid') { %>
                                            <span class="status status-approved">PAID</span>
                                        <% } else if (booking.paymentStatus === 'failed') { %>
                                            <span class="status status-rejected">FAILED</span>
                                        <% } else { %>
                                            <span class="status status-pending">PENDING</span>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- RECORD DETAILS GRID -->
                                <div class="record-details-grid">
                                    <div class="record-detail-item">
                                        <span class="record-label">Owner</span>
                                        <span class="record-value">
                                            👤 <%= (booking.vehicleId && booking.vehicleId.ownerId && booking.vehicleId.ownerId.name) ? booking.vehicleId.ownerId.name : 'Vehicle Owner' %>
                                        </span>
                                    </div>

                                    <div class="record-detail-item">
                                        <span class="record-label">Amount</span>
                                        <span class="record-value record-amount">₹<%= booking.totalAmount !== undefined ? booking.totalAmount : 0 %></span>
                                    </div>

                                    <div class="record-detail-item">
                                        <span class="record-label">Start Date</span>
                                        <span class="record-value">📅 <%= new Date(booking.startDate).toLocaleDateString() %></span>
                                    </div>

                                    <div class="record-detail-item">
                                        <span class="record-label">End Date</span>
                                        <span class="record-value">📅 <%= new Date(booking.endDate).toLocaleDateString() %></span>
                                    </div>
                                </div>

                                <!-- ACTIONS -->
                                <div class="record-actions">
                                    <% if ((booking.status === 'confirmed' || booking.status === 'ongoing') && booking.paymentStatus !== 'paid') { %>
                                        <a href="/payment/pay/<%= booking._id %>" class="record-action-btn pay-btn">
                                            💳 Pay Now
                                        </a>
                                    <% } %>

                                    <% if ((booking.status === 'pending' || booking.status === 'confirmed') && new Date(booking.startDate) > new Date()) { %>
                                        <form action="/bookings/cancel/<%= booking._id %>" method="POST" onsubmit="return confirm('Are you sure you want to cancel this booking?');" style="flex: 1; min-width: 110px; display: flex;">
                                            <button type="submit" class="record-action-btn reject-btn" style="width: 100%;">
                                                Cancel Booking
                                            </button>
                                        </form>
                                    <% } %>

                                    <a href="/complaint?bookingId=<%= booking._id %>" class="record-action-btn reset-btn">
                                        Report a Complaint
                                    </a>
                                </div>
                            </div>
                        <% }) %>


                    </div>


                    <% } else { %>


                        <!-- ================= EMPTY STATE ================= -->

                        <div class="empty">


                            <h2>
                                No Bookings Found
                            </h2>


                            <% if (status || type) { %>


                                <p>

                                    No bookings match your selected filters.

                                    Try changing the filters.

                                </p>


                                <% } else { %>


                                    <p>

                                        You haven't booked any vehicles yet.

                                    </p>


                                    <% } %>



                                        <a href="/user/dashboard" class="btn">
                                            Go Home
                                        </a>


                        </div>


                        <% } %>


    </div>


</body>

</html>