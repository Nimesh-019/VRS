<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        My Bookings - Vehicle Rental System
    </title>

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>


    <!-- ================= HEADER ================= -->

    <header>

        <h1>

            <span>V</span>RS - Vehicle Rentals

        </h1>


        <div class="user-nav">

            <span>

                Welcome,

                <strong>
                    <%= user.name %>
                </strong>

                (Customer)

            </span>


            <a href="/bookings" class="bookings-btn">
                My Bookings
            </a>

            <a href="/complaints" class="bookings-btn">
                My Complaints
            </a>


            <a href="/logout" class="logout-btn">
                Logout
            </a>

        </div>

    </header>



    <!-- ================= MAIN ================= -->

    <div class="container">


        <!-- ================= PAGE HEADER ================= -->

        <div class="section-header">

            <div>

                <h2>
                    My Bookings
                </h2>

                <p>
                    View and manage your vehicle rental bookings.
                </p>

            </div>


            <div style="display: flex; gap: 10px;">
                <a href="/complaint" class="btn">
                    Report a Complaint
                </a>

                <a href="/complaints" class="reset-btn">
                    My Complaints
                </a>

                <a href="/user/dashboard" class="home-btn">
                    Go Home
                </a>
            </div>

        </div>



        <!-- ================= FILTER ================= -->

        <div class="filter-box">

            <form action="/bookings" method="GET" class="filter-form">


                <!-- BOOKING STATUS -->

                <select name="status">

                    <option value="">
                        All Booking Status
                    </option>


                    <option value="pending" <%=status==='pending' ? 'selected' : '' %>
                        >
                        Pending
                    </option>


                    <option value="confirmed" <%=status==='confirmed' ? 'selected' : '' %>
                        >
                        Confirmed
                    </option>


                    <option value="cancelled" <%=status==='cancelled' ? 'selected' : '' %>
                        >
                        Cancelled
                    </option>

                </select>



                <!-- VEHICLE TYPE -->

                <select name="type">

                    <option value="">
                        All Vehicle Types
                    </option>


                    <option value="Car" <%=type==='Car' ? 'selected' : '' %>
                        >
                        Car
                    </option>


                    <option value="Bike" <%=type==='Bike' ? 'selected' : '' %>
                        >
                        Bike
                    </option>


                    <option value="Scooter" <%=type==='Scooter' ? 'selected' : '' %>
                        >
                        Scooter
                    </option>


                    <option value="SUV" <%=type==='SUV' ? 'selected' : '' %>
                        >
                        SUV
                    </option>


                    <option value="Other" <%=type==='Other' ? 'selected' : '' %>
                        >
                        Other
                    </option>

                </select>



                <!-- FILTER BUTTON -->

                <button type="submit" class="filter-btn">
                    Filter
                </button>



                <!-- CLEAR -->

                <a href="/bookings" class="clear-filter-btn">
                    Clear
                </a>

            </form>

        </div>



        <!-- ================= RESULTS ================= -->

        <% if (bookings && bookings.length> 0) { %>

            <div class="results-info">

                Showing

                <strong>
                    <%= bookings.length %>
                </strong>

                booking<%= bookings.length===1 ? '' : 's' %>

            </div>

            <% } %>



                <!-- ================= BOOKINGS ================= -->

                <% if (bookings && bookings.length> 0) { %>


                    <div class="booking-grid">


                        <% bookings.forEach(booking=> { %>


                            <div class="booking-card">


                                <!-- ================= IMAGE ================= -->

                                <div class="vehicle-image">


                                    <% if ( booking.vehicleId && booking.vehicleId.image ) { %>


                                        <img src="<%= booking.vehicleId.image %>"
                                            alt="<%= booking.vehicleId.brand %> <%= booking.vehicleId.model %>">


                                        <% } else { %>


                                            <div class="no-image">

                                                No Image Available

                                            </div>


                                            <% } %>


                                </div>



                                <!-- ================= HEADER ================= -->

                                <div class="card-header">


                                    <div>


                                        <div class="vehicle-name">


                                            <% if (booking.vehicleId) { %>


                                                <%= booking.vehicleId.brand || '' %>
                                                    <%= booking.vehicleId.model || '' %>


                                                        <% } else { %>


                                                            Vehicle


                                                            <% } %>


                                        </div>



                                        <div class="vehicle-number">


                                            Reg No:


                                            <% if (booking.vehicleId) { %>


                                                <%= booking.vehicleId.vehicleNumber || 'N/A' %>


                                                    <% } else { %>


                                                        N/A


                                                        <% } %>


                                        </div>


                                    </div>



                                    <!-- VEHICLE TYPE -->

                                    <% if ( booking.vehicleId && booking.vehicleId.type ) { %>


                                        <span class="vehicle-type">

                                            <%= booking.vehicleId.type %>

                                        </span>


                                        <% } %>


                                </div>



                                <!-- ================= BODY ================= -->

                                <div class="card-body">


                                    <!-- START DATE -->

                                    <div class="info">

                                        <strong>
                                            Start Date:
                                        </strong>

                                        <%= new Date( booking.startDate ).toLocaleDateString() %>

                                    </div>



                                    <!-- END DATE -->

                                    <div class="info">

                                        <strong>
                                            End Date:
                                        </strong>

                                        <%= new Date( booking.endDate ).toLocaleDateString() %>

                                    </div>



                                    <!-- ================= AMOUNT ================= -->

                                    <% if (booking.totalAmount !==undefined) { %>


                                        <div class="amount">

                                            ₹<%= booking.totalAmount %>

                                        </div>


                                        <% } %>



                                            <!-- ================= STATUS ================= -->

                                            <div>

                                                <strong>
                                                    Status:
                                                </strong>


                                                <% if (booking.status==='pending' ) { %>


                                                    <span class="status pending">

                                                        PENDING

                                                    </span>


                                                    <% } else if (booking.status==='confirmed' ) { %>


                                                        <span class="status confirmed">

                                                            CONFIRMED

                                                        </span>


                                                        <% } else if (booking.status==='cancelled' ) { %>


                                                            <span class="status cancelled">

                                                                CANCELLED

                                                            </span>


                                                            <% } else { %>


                                                                <span class="status pending">

                                                                    PENDING

                                                                </span>


                                                                <% } %>

                                            </div>



                                            <!-- ================= PAYMENT STATUS ================= -->

                                            <div style="margin-top: 10px;">

                                                <strong>
                                                    Payment:
                                                </strong>


                                                <% if (booking.paymentStatus==='paid' ) { %>


                                                    <span class="status confirmed">

                                                        PAID

                                                    </span>


                                                    <% } else { %>


                                                        <span class="status pending">

                                                            PENDING

                                                        </span>


                                                        <% } %>

                                            </div>



                                            <!-- ================= PAY NOW ================= -->

                                            <% if ( booking.status==='confirmed' && booking.paymentStatus !=='paid' ) {
                                                %>


                                                <div style="margin-top: 15px;">

                                                    <a href="/payment/pay/<%= booking._id %>" class="btn">
                                                        Pay Now
                                                    </a>

                                                </div>


                                                <% } %>






                                </div>

                            </div>


                            <% }) %>


                    </div>


                    <% } else { %>


                        <!-- ================= EMPTY STATE ================= -->

                        <div class="empty">


                            <h2>
                                No Bookings Found
                            </h2>


                            <% if (status || type) { %>


                                <p>

                                    No bookings match your selected filters.

                                    Try changing the filters.

                                </p>


                                <% } else { %>


                                    <p>

                                        You haven't booked any vehicles yet.

                                    </p>


                                    <% } %>



                                        <a href="/user/dashboard" class="btn">
                                            Go Home
                                        </a>


                        </div>


                        <% } %>


    </div>


</body>

</html>