<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Owner Dashboard - Vehicle Rental System</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <!-- ================= HEADER ================= -->

    <header>

        <h1>
            <span>V</span>RS - Vehicle Rentals
        </h1>

        <div class="user-nav">

            <span>

                Welcome,

                <strong>
                    <%= typeof user !=='undefined' && user && user.name ? user.name : 'Owner' %>
                </strong>

                (Owner)

            </span>

            <a href="/logout" class="logout-btn">
                Logout
            </a>

        </div>

    </header>

    <div class="container">

        <!-- ================= PROFILE ================= -->

        <div class="profile-card">

            <h3>
                Owner Profile
            </h3>

            <p>

                <strong>Name:</strong>

                <%= typeof user !=='undefined' && user && user.name ? user.name : 'N/A' %>

            </p>

            <p>

                <strong>Email:</strong>

                <%= typeof user !=='undefined' && user && user.email ? user.email : 'N/A' %>

            </p>

        </div>

        <!-- ================= TOP BAR ================= -->

        <div class="top-bar">

            <h2>
                Vehicles Listed for Rent
            </h2>

            <div class="top-actions">

                <a href="/owner/history" class="btn-history">
                    Rental History
                </a>
                <a href="/owner/complaints" class="btn-history">
                    Customer Complaints
                </a>
                <a href="/owner/vehicles/add" class="btn-add">
                    + Add New Vehicle
                </a>

            </div>

        </div>

        <!-- ================= FILTER ================= -->

        <div class="filter-container">

            <form action="/owner/dashboard" method="GET" class="filter-form">

                <!-- SEARCH -->

                <div class="filter-group search-group">

                    <label for="search">
                        Search
                    </label>

                    <input type="text" id="search" name="search" placeholder="Brand, model or vehicle number..."
                        value="<%= typeof search !== 'undefined' ? search : '' %>">

                </div>

                <!-- VEHICLE TYPE -->

                <div class="filter-group">

                    <label for="type">
                        Vehicle Type
                    </label>

                    <select name="type" id="type">

                        <option value="">
                            All Types
                        </option>

                        <option value="Car" <%=typeof selectedType !=='undefined' && selectedType==='Car' ? 'selected'
                            : '' %>
                            >
                            Car
                        </option>

                        <option value="Bike" <%=typeof selectedType !=='undefined' && selectedType==='Bike' ? 'selected'
                            : '' %>
                            >
                            Bike
                        </option>

                    </select>

                </div>

                <!-- AVAILABILITY -->

                <div class="filter-group">

                    <label for="availability">
                        Availability
                    </label>

                    <select name="availability" id="availability">

                        <option value="">
                            All
                        </option>

                        <option value="available" <%=typeof selectedAvailability !=='undefined' &&
                            selectedAvailability==='available' ? 'selected' : '' %>
                            >
                            Available
                        </option>

                        <option value="unavailable" <%=typeof selectedAvailability !=='undefined' &&
                            selectedAvailability==='unavailable' ? 'selected' : '' %>
                            >
                            Not Available
                        </option>

                    </select>

                </div>

                <!-- SORT -->

                <div class="filter-group">

                    <label for="sort">
                        Sort By
                    </label>

                    <select name="sort" id="sort">

                        <option value="">
                            Latest
                        </option>

                        <option value="priceAsc" <%=typeof selectedSort !=='undefined' && selectedSort==='priceAsc'
                            ? 'selected' : '' %>
                            >
                            Price: Low to High
                        </option>

                        <option value="priceDesc" <%=typeof selectedSort !=='undefined' && selectedSort==='priceDesc'
                            ? 'selected' : '' %>
                            >
                            Price: High to Low
                        </option>

                        <option value="nameAsc" <%=typeof selectedSort !=='undefined' && selectedSort==='nameAsc'
                            ? 'selected' : '' %>
                            >
                            Name: A-Z
                        </option>

                    </select>

                </div>

                <!-- BUTTONS -->

                <div class="filter-buttons">

                    <button type="submit" class="filter-btn">
                        Apply Filter
                    </button>

                    <a href="/owner/dashboard" class="reset-btn">
                        Reset
                    </a>

                </div>

            </form>

            <!-- FILTER RESULT -->

            <% if ( (typeof search !=='undefined' && search) || (typeof selectedType !=='undefined' && selectedType) ||
                (typeof selectedAvailability !=='undefined' && selectedAvailability) || (typeof selectedSort
                !=='undefined' && selectedSort) ) { %>

                <div class="filter-result">

                    Showing

                    <strong>
                        <%= vehicles ? vehicles.length : 0 %>
                    </strong>

                    matching vehicle(s).

                </div>

                <% } %>

        </div>

        <!-- ================= VEHICLES ================= -->

        <% if (vehicles && vehicles.length> 0) { %>

            <div class="grid">

                <% vehicles.forEach(vehicle=> { %>

                    <div class="card">

                        <!-- VEHICLE IMAGE -->

                        <div class="vehicle-image">

                            <% if (vehicle.image) { %>

                                <img src="<%= vehicle.image %>" alt="<%= vehicle.brand %> <%= vehicle.model %>">

                                <% } else { %>

                                    <div class="no-image">
                                        No Image Available
                                    </div>

                                    <% } %>

                        </div>

                        <!-- CARD HEADER -->

                        <div class="card-header">

                            <div class="card-title">

                                <%= vehicle.brand %>
                                    <%= vehicle.model %>

                            </div>

                            <span class="badge-type">

                                <%= vehicle.type || 'Vehicle' %>

                            </span>

                        </div>

                        <!-- CARD BODY -->

                        <div class="card-body">

                            <div class="vehicle-num">

                                Vehicle Reg No:

                                <strong>
                                    <%= vehicle.vehicleNumber %>
                                </strong>

                            </div>

                            <div class="price-tag">

                                ₹<%= vehicle.pricePerDay %>

                                    <span>
                                        / day
                                    </span>

                            </div>

                            <% if (vehicle.description) { %>

                                <p class="description">

                                    <%= vehicle.description %>

                                </p>

                                <% } %>

                                    <!-- VEHICLE AVAILABILITY -->

                                    <p class="status-tag
                            <%= vehicle.availability
                                ? 'status-available'
                                : 'status-unavailable'
                            %>">

                                        Status:

                                        <%= vehicle.availability ? 'Available for Rent' : 'Not Available' %>

                                    </p>

                                    <!-- ================= APPROVAL STATUS ================= -->

                                    <div class="approval-section">

                                        <div class="approval-label">
                                            Admin Approval:
                                        </div>

                                        <% if (vehicle.approvalStatus==='approved' ) { %>

                                            <span class="approval-badge approval-approved">
                                                ✓ Approved
                                            </span>

                                            <% } else if (vehicle.approvalStatus==='rejected' ) { %>

                                                <span class="approval-badge approval-rejected">
                                                    ✕ Rejected
                                                </span>

                                                <% if (vehicle.rejectionReason) { %>

                                                    <div class="rejection-reason">

                                                        <strong>
                                                            Admin Reason:
                                                        </strong>

                                                        <%= vehicle.rejectionReason %>

                                                    </div>

                                                    <% } %>

                                                        <% } else { %>

                                                            <span class="approval-badge approval-pending">
                                                                ⏳ Pending Approval
                                                            </span>

                                                            <p class="pending-message">

                                                                Your vehicle is waiting for
                                                                admin approval.

                                                            </p>

                                                            <% } %>

                                    </div>

                        </div>

                        <!-- CARD ACTIONS -->

                        <div class="card-actions">

                            <a href="/owner/vehicles/edit/<%= vehicle._id %>" class="btn-edit">
                                Edit
                            </a>

                            <form action="/owner/vehicles/delete/<%= vehicle._id %>" method="POST"
                                style="display:inline;" onsubmit="return confirm(
                                'Are you sure you want to delete this vehicle?'
                            );">

                                <button type="submit" class="btn-delete">
                                    Delete
                                </button>

                            </form>

                        </div>

                    </div>

                    <% }) %>

            </div>

            <% } else { %>

                <!-- ================= NO RESULTS / EMPTY STATE ================= -->

                <div class="empty-state">

                    <% if ( (typeof search !=='undefined' && search) || (typeof selectedType !=='undefined' &&
                        selectedType) || (typeof selectedAvailability !=='undefined' && selectedAvailability) ) { %>

                        <h3>
                            No Vehicles Found
                        </h3>

                        <p>
                            No vehicles match your current filter.
                        </p>

                        <a href="/owner/dashboard" class="reset-btn">
                            Clear Filters
                        </a>

                        <% } else { %>

                            <h3>
                                No Vehicles Listed
                            </h3>

                            <p>
                                You haven't listed any vehicles for rent yet.
                            </p>

                            <a href="/owner/vehicles/add" class="btn-add">
                                + Add Your First Vehicle
                            </a>

                            <% } %>

                </div>

                <% } %>

    </div>
</body>

</html>