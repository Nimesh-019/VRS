<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Complaints - Owner
    </title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- ================= HEADER ================= -->

    <header>

        <h1>
            VRS - Owner Panel
        </h1>

        <div class="nav-links">

            <span>
                Welcome,
                <strong>
                    <%= user.name %>
                </strong>
            </span>

            <a href="/owner/dashboard">
                Dashboard
            </a>

            <a href="/owner/history">
                Booking History
            </a>

            <a href="/owner/complaints">
                Complaints
            </a>

            <a
                href="/logout"
                class="logout"
            >
                Logout
            </a>

        </div>

    </header>

    <!-- ================= MAIN ================= -->

    <div class="container">

        <div class="page-header">

            <h2>
                Customer Complaints
            </h2>

            <p>
                View complaints related to your vehicles and respond directly to customers.
            </p>

        </div>

        <!-- ================= COMPLAINTS ================= -->

        <% if (complaints && complaints.length > 0) { %>

            <% complaints.forEach(complaint => { %>

                <div class="complaint-card">

                    <!-- ================= HEADER ================= -->

                    <div class="card-header">

                        <div>

                            <h3>
                                <%= complaint.subject %>
                            </h3>

                            <div class="date">

                                Submitted:

                                <%= new Date(
                                    complaint.createdAt
                                ).toLocaleString() %>

                            </div>

                        </div>

                        <% if (
                            complaint.status === 'resolved'
                        ) { %>

                            <span class="status resolved">
                                RESOLVED
                            </span>

                        <% } else { %>

                            <span class="status pending">
                                PENDING
                            </span>

                        <% } %>

                    </div>

                    <!-- ================= CUSTOMER INFO ================= -->

                    <div class="info-grid">

                        <div class="info-box">

                            <h4>
                                Customer
                            </h4>

                            <% if (complaint.customerId) { %>

                                <p>
                                    <strong>
                                        Name:
                                    </strong>

                                    <%= complaint.customerId.name %>
                                </p>

                                <p>
                                    <strong>
                                        Email:
                                    </strong>

                                    <%= complaint.customerId.email %>
                                </p>

                                <p>
                                    <strong>
                                        Phone:
                                    </strong>

                                    <%= complaint.customerId.phone %>
                                </p>

                            <% } %>

                        </div>

                        <!-- ================= BOOKING ================= -->

                        <div class="info-box">

                            <h4>
                                Rental Details
                            </h4>

                            <% if (complaint.bookingId) { %>

                                <p>

                                    <strong>
                                        Start:
                                    </strong>

                                    <%= new Date(
                                        complaint.bookingId.startDate
                                    ).toLocaleDateString() %>

                                </p>

                                <p>

                                    <strong>
                                        End:
                                    </strong>

                                    <%= new Date(
                                        complaint.bookingId.endDate
                                    ).toLocaleDateString() %>

                                </p>

                                <p>

                                    <strong>
                                        Amount:
                                    </strong>

                                    ₹<%= complaint.bookingId.totalAmount %>

                                </p>

                            <% } %>

                        </div>

                    </div>

                    <!-- ================= VEHICLE ================= -->

                    <div class="vehicle-section">

                        <% if (
                            complaint.vehicleId &&
                            complaint.vehicleId.image
                        ) { %>

                            <img
                                src="<%= complaint.vehicleId.image %>"
                                alt="Vehicle"
                                class="vehicle-image"
                            >

                        <% } else { %>

                            <div class="no-image">
                                No Image Available
                            </div>

                        <% } %>

                        <div class="vehicle-info">

                            <h3>

                                <% if (complaint.vehicleId) { %>

                                    <%= complaint.vehicleId.brand || '' %>

                                    <%= complaint.vehicleId.model || '' %>

                                <% } else { %>

                                    Vehicle

                                <% } %>

                            </h3>

                            <% if (complaint.vehicleId) { %>

                                <p>

                                    <strong>
                                        Vehicle Number:
                                    </strong>

                                    <%= complaint.vehicleId.vehicleNumber || 'N/A' %>

                                </p>

                                <p>

                                    <strong>
                                        Type:
                                    </strong>

                                    <%= complaint.vehicleId.type || 'N/A' %>

                                </p>

                            <% } %>

                        </div>

                    </div>

                    <!-- ================= COMPLAINT ================= -->

                    <div class="complaint-section">

                        <h3>
                            Customer Complaint
                        </h3>

                        <div class="subject">
                            <%= complaint.subject %>
                        </div>

                        <div class="message">
                            <%= complaint.message %>
                        </div>

                    </div>

                    <!-- ================= OWNER RESPONSE ================= -->

                    <% if (complaint.ownerReply || complaint.adminReply) { %>

                        <div style="margin-top: 20px; padding: 16px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px;">

                            <h4 style="color: #166534; font-size: 14px; margin-bottom: 6px; font-weight: 700;">
                                ✓ Your Response to Customer:
                            </h4>

                            <p style="color: #15803d; font-size: 14px; margin: 0; line-height: 1.5;">
                                <%= complaint.ownerReply || complaint.adminReply %>
                            </p>

                        </div>

                    <% } else { %>

                        <form action="/owner/complaint/<%= complaint._id %>/reply" method="POST" style="margin-top: 20px; padding: 18px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px;">

                            <div class="form-group" style="margin-bottom: 12px;">

                                <label for="reply-<%= complaint._id %>" style="font-weight: 600; font-size: 13px; color: #1e293b;">
                                    Send Response to Customer:
                                </label>

                                <textarea name="ownerReply" id="reply-<%= complaint._id %>" required rows="3" placeholder="Type your response to the customer here..." style="width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 7px; font-size: 14px; margin-top: 6px;"></textarea>

                            </div>

                            <button type="submit" class="btn" style="height: 38px; padding: 0 20px; font-size: 13px;">
                                Send Response
                            </button>

                        </form>

                    <% } %>

                </div>

            <% }) %>

        <% } else { %>

            <!-- ================= EMPTY ================= -->

            <div class="empty">

                <h2>
                    No Complaints
                </h2>

                <p>
                    There are no complaints related to your vehicles.
                </p>

            </div>

        <% } %>

    </div>

</body>

</html>