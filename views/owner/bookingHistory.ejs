<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Booking History - Vehicle Rental System</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- ================= HEADER ================= -->

    <header>

        <h1>
            <span>V</span>RS - Vehicle Rentals
        </h1>

        <div class="user-nav">

            <span>

                Welcome,

                <strong>
                    <%= user && user.name ? user.name : 'Owner' %>
                </strong>

                (Owner)

            </span>

            <a
                href="/logout"
                class="logout-btn"
            >
                Logout
            </a>

        </div>

    </header>

    <!-- ================= MAIN ================= -->

    <div class="container">

        <!-- ================= TOP BAR ================= -->

        <div class="top-bar">

            <h2>
                Booking History
            </h2>

            <a
                href="/owner/dashboard"
                class="back-btn"
            >
                ← Back to Dashboard
            </a>

        </div>

        <!-- ================= FILTER ================= -->

        <div class="filter-container">

            <form
                action="/owner/history"
                method="GET"
                class="filter-form"
            >

                <!-- SEARCH -->

                <div class="filter-group search-group">

                    <label for="search">
                        Search
                    </label>

                    <input
                        type="text"
                        id="search"
                        name="search"
                        placeholder="Customer, email, vehicle or registration..."
                        value="<%= typeof search !== 'undefined' ? search : '' %>"
                    >

                </div>

                <!-- BOOKING STATUS -->

                <div class="filter-group">

                    <label for="status">
                        Booking Status
                    </label>

                    <select
                        name="status"
                        id="status"
                    >

                        <option value="">
                            All Status
                        </option>

                        <option
                            value="pending"
                            <%= typeof status !== 'undefined' &&
                                status === 'pending'
                                ? 'selected'
                                : ''
                            %>
                        >
                            Pending
                        </option>

                        <option
                            value="confirmed"
                            <%= typeof status !== 'undefined' &&
                                status === 'confirmed'
                                ? 'selected'
                                : ''
                            %>
                        >
                            Confirmed
                        </option>

                        <option
                            value="ongoing"
                            <%= typeof status !== 'undefined' &&
                                status === 'ongoing'
                                ? 'selected'
                                : ''
                            %>
                        >
                            Ongoing
                        </option>

                        <option
                            value="completed"
                            <%= typeof status !== 'undefined' &&
                                status === 'completed'
                                ? 'selected'
                                : ''
                            %>
                        >
                            Completed
                        </option>

                        <option
                            value="rejected"
                            <%= typeof status !== 'undefined' &&
                                status === 'rejected'
                                ? 'selected'
                                : ''
                            %>
                        >
                            Rejected
                        </option>

                        <option
                            value="cancelled"
                            <%= typeof status !== 'undefined' &&
                                status === 'cancelled'
                                ? 'selected'
                                : ''
                            %>
                        >
                            Cancelled
                        </option>

                        <option
                            value="expired"
                            <%= typeof status !== 'undefined' &&
                                status === 'expired'
                                ? 'selected'
                                : ''
                            %>
                        >
                            Expired
                        </option>

                    </select>

                </div>

                <!-- PAYMENT STATUS -->

                <div class="filter-group">

                    <label for="paymentStatus">
                        Payment
                    </label>

                    <select
                        name="paymentStatus"
                        id="paymentStatus"
                    >

                        <option value="">
                            All Payments
                        </option>

                        <option
                            value="pending"
                            <%= typeof paymentStatus !== 'undefined' &&
                                paymentStatus === 'pending'
                                ? 'selected'
                                : ''
                            %>
                        >
                            Pending
                        </option>

                        <option
                            value="paid"
                            <%= typeof paymentStatus !== 'undefined' &&
                                paymentStatus === 'paid'
                                ? 'selected'
                                : ''
                            %>
                        >
                            Paid
                        </option>

                    </select>

                </div>

                <!-- BUTTONS -->

                <div class="filter-buttons">

                    <button
                        type="submit"
                        class="filter-btn"
                    >
                        Apply Filter
                    </button>

                    <a
                        href="/owner/history"
                        class="reset-btn"
                    >
                        Reset
                    </a>

                </div>

            </form>

            <!-- ================= FILTER RESULT ================= -->

            <% if (
                (typeof search !== 'undefined' && search) ||
                (typeof status !== 'undefined' && status) ||
                (typeof paymentStatus !== 'undefined' && paymentStatus)
            ) { %>

                <div class="filter-result">

                    Showing

                    <strong>
                        <%= bookings ? bookings.length : 0 %>
                    </strong>

                    matching booking(s).

                </div>

            <% } %>

        </div>

        <!-- ================= BOOKINGS ================= -->

        <% if (bookings && bookings.length > 0) { %>

            <div class="history-grid">

                <% bookings.forEach(booking => { %>

                    <div class="booking-record-card">
                        <!-- HEADER -->
                        <div class="record-header">
                            <div class="record-title-box">
                                <div class="record-title">
                                    <%= booking.vehicleId ? `${booking.vehicleId.brand || ''} ${booking.vehicleId.model || ''}`.trim() : 'Vehicle' %>
                                    <% if (booking.vehicleId && booking.vehicleId.type) { %>
                                        <span class="record-type-badge"><%= booking.vehicleId.type %></span>
                                    <% } %>
                                </div>
                                <div class="record-subtitle">
                                    Reg No: <strong><%= booking.vehicleId ? (booking.vehicleId.vehicleNumber || 'N/A') : 'N/A' %></strong>
                                </div>
                            </div>

                            <div class="record-badges">
                                <% if (booking.status === 'pending') { %>
                                    <span class="status pending">🟡 Pending approval</span>
                                <% } else if (booking.status === 'confirmed') { %>
                                    <span class="status confirmed">🔵 Confirmed</span>
                                <% } else if (booking.status === 'ongoing') { %>
                                    <span class="status ongoing">🟢 Ongoing</span>
                                <% } else if (booking.status === 'completed') { %>
                                    <span class="status completed">⚪ Completed</span>
                                <% } else if (booking.status === 'rejected') { %>
                                    <span class="status rejected">🔴 Rejected</span>
                                <% } else if (booking.status === 'cancelled') { %>
                                    <span class="status cancelled">⚫ Cancelled</span>
                                <% } else if (booking.status === 'expired') { %>
                                    <span class="status expired">🟠 Expired</span>
                                <% } else { %>
                                    <span class="status pending">🟡 <%= (booking.status || 'pending').toUpperCase() %></span>
                                <% } %>

                                <% if (booking.paymentStatus === 'paid') { %>
                                    <span class="status status-approved">PAID</span>
                                <% } else if (booking.paymentStatus === 'failed') { %>
                                    <span class="status status-rejected">FAILED</span>
                                <% } else { %>
                                    <span class="status status-pending">PENDING</span>
                                <% } %>
                            </div>
                        </div>

                        <!-- DETAILS GRID -->
                        <div class="record-details-grid">
                            <div class="record-detail-item">
                                <span class="record-label">Customer</span>
                                <span class="record-value">👤 <%= booking.userId ? (booking.userId.name || 'Unknown') : 'Unknown' %></span>
                            </div>

                            <div class="record-detail-item">
                                <span class="record-label">Amount</span>
                                <span class="record-value record-amount">₹<%= booking.totalAmount !== undefined ? booking.totalAmount : 0 %></span>
                            </div>

                            <div class="record-detail-item">
                                <span class="record-label">Start Date</span>
                                <span class="record-value">📅 <%= booking.startDate ? new Date(booking.startDate).toLocaleDateString() : 'N/A' %></span>
                            </div>

                            <div class="record-detail-item">
                                <span class="record-label">End Date</span>
                                <span class="record-value">📅 <%= booking.endDate ? new Date(booking.endDate).toLocaleDateString() : 'N/A' %></span>
                            </div>

                            <% if (booking.userId && (booking.userId.email || booking.userId.phone)) { %>
                                <div class="record-detail-item full-width">
                                    <span class="record-label">Customer Contact</span>
                                    <span class="record-value" style="font-size: 13px; color: #475569;">
                                        <% if (booking.userId.email) { %>✉️ <%= booking.userId.email %><% } %>
                                        <% if (booking.userId.email && booking.userId.phone) { %> &nbsp;•&nbsp; <% } %>
                                        <% if (booking.userId.phone) { %>📞 <%= booking.userId.phone %><% } %>
                                    </span>
                                </div>
                            <% } %>
                        </div>

                        <!-- ACTIONS (PENDING ONLY) -->
                        <% if (booking.status === 'pending') { %>
                            <div class="record-actions">
                                <form action="/owner/booking/<%= booking._id %>/confirm" method="POST" style="flex: 1; display: flex;">
                                    <button type="submit" class="action-btn confirm-btn record-action-btn" style="width: 100%;">
                                        Approve
                                    </button>
                                </form>

                                <form action="/owner/booking/<%= booking._id %>/reject" method="POST" style="flex: 1; display: flex;">
                                    <button type="submit" class="action-btn reject-btn record-action-btn" style="width: 100%;">
                                        Reject
                                    </button>
                                </form>
                            </div>
                        <% } %>
                    </div>

                <% }) %>

            </div>

        <% } else { %>

            <!-- ================= EMPTY / NO RESULTS ================= -->

            <div class="empty-state">

                <% if (
                    (typeof search !== 'undefined' && search) ||
                    (typeof status !== 'undefined' && status) ||
                    (typeof paymentStatus !== 'undefined' && paymentStatus)
                ) { %>

                    <h3>
                        No Matching Bookings
                    </h3>

                    <p>
                        No bookings match your selected filters.
                    </p>

                    <a
                        href="/owner/history"
                        class="reset-btn"
                    >
                        Clear Filters
                    </a>

                <% } else { %>

                    <h3>
                        No Booking History
                    </h3>

                    <p>
                        No bookings have been made for your vehicles yet.
                    </p>

                <% } %>

            </div>

        <% } %>

    </div>

</body>

</html>