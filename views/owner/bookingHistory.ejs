<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Booking History - Vehicle Rental System</title>


    <link rel="stylesheet" href="/css/owner-booking-history.css">
</head>

</head>


<body>


    <!-- ================= HEADER ================= -->

    <header>

        <h1>
            <span>V</span>RS - Vehicle Rentals
        </h1>


        <div class="user-nav">

            <span>

                Welcome,

                <strong>
                    <%= user && user.name ? user.name : 'Owner' %>
                </strong>

                (Owner)

            </span>


            <a
                href="/logout"
                class="logout-btn"
            >
                Logout
            </a>

        </div>

    </header>


    <!-- ================= MAIN ================= -->

    <div class="container">


        <!-- ================= TOP BAR ================= -->

        <div class="top-bar">

            <h2>
                Booking History
            </h2>


            <a
                href="/owner/dashboard"
                class="back-btn"
            >
                ← Back to Dashboard
            </a>

        </div>


        <!-- ================= FILTER ================= -->

        <div class="filter-container">

            <form
                action="/owner/history"
                method="GET"
                class="filter-form"
            >


                <!-- SEARCH -->

                <div class="filter-group search-group">

                    <label for="search">
                        Search
                    </label>


                    <input
                        type="text"
                        id="search"
                        name="search"
                        placeholder="Customer, email, vehicle or registration..."
                        value="<%= typeof search !== 'undefined' ? search : '' %>"
                    >

                </div>


                <!-- BOOKING STATUS -->

                <div class="filter-group">

                    <label for="status">
                        Booking Status
                    </label>


                    <select
                        name="status"
                        id="status"
                    >

                        <option value="">
                            All Status
                        </option>


                        <option
                            value="pending"
                            <%= typeof status !== 'undefined' &&
                                status === 'pending'
                                ? 'selected'
                                : ''
                            %>
                        >
                            Pending
                        </option>


                        <option
                            value="confirmed"
                            <%= typeof status !== 'undefined' &&
                                status === 'confirmed'
                                ? 'selected'
                                : ''
                            %>
                        >
                            Confirmed
                        </option>


                        <option
                            value="completed"
                            <%= typeof status !== 'undefined' &&
                                status === 'completed'
                                ? 'selected'
                                : ''
                            %>
                        >
                            Completed
                        </option>


                        <option
                            value="cancelled"
                            <%= typeof status !== 'undefined' &&
                                status === 'cancelled'
                                ? 'selected'
                                : ''
                            %>
                        >
                            Cancelled
                        </option>

                    </select>

                </div>


                <!-- PAYMENT STATUS -->

                <div class="filter-group">

                    <label for="paymentStatus">
                        Payment
                    </label>


                    <select
                        name="paymentStatus"
                        id="paymentStatus"
                    >

                        <option value="">
                            All Payments
                        </option>


                        <option
                            value="pending"
                            <%= typeof paymentStatus !== 'undefined' &&
                                paymentStatus === 'pending'
                                ? 'selected'
                                : ''
                            %>
                        >
                            Pending
                        </option>


                        <option
                            value="paid"
                            <%= typeof paymentStatus !== 'undefined' &&
                                paymentStatus === 'paid'
                                ? 'selected'
                                : ''
                            %>
                        >
                            Paid
                        </option>

                    </select>

                </div>


                <!-- BUTTONS -->

                <div class="filter-buttons">

                    <button
                        type="submit"
                        class="filter-btn"
                    >
                        Apply Filter
                    </button>


                    <a
                        href="/owner/history"
                        class="reset-btn"
                    >
                        Reset
                    </a>

                </div>

            </form>


            <!-- ================= FILTER RESULT ================= -->

            <% if (
                (typeof search !== 'undefined' && search) ||
                (typeof status !== 'undefined' && status) ||
                (typeof paymentStatus !== 'undefined' && paymentStatus)
            ) { %>

                <div class="filter-result">

                    Showing

                    <strong>
                        <%= bookings ? bookings.length : 0 %>
                    </strong>

                    matching booking(s).

                </div>

            <% } %>

        </div>


        <!-- ================= BOOKINGS ================= -->

        <% if (bookings && bookings.length > 0) { %>


            <div class="history-grid">


                <% bookings.forEach(booking => { %>


                    <div class="booking-card">


                        <!-- ================= VEHICLE IMAGE ================= -->

                        <div class="vehicle-image">

                            <% if (
                                booking.vehicleId &&
                                booking.vehicleId.image
                            ) { %>

                                <img
                                    src="<%= booking.vehicleId.image %>"
                                    alt="<%= booking.vehicleId.brand || '' %> <%= booking.vehicleId.model || '' %>"
                                >

                            <% } else { %>

                                <div class="no-image">
                                    No Image Available
                                </div>

                            <% } %>

                        </div>


                        <!-- ================= VEHICLE HEADER ================= -->

                        <div class="card-header">


                            <div>

                                <div class="vehicle-name">

                                    <%= booking.vehicleId
                                        ? (booking.vehicleId.brand || '')
                                        : 'Vehicle' %>

                                    <%= booking.vehicleId
                                        ? (booking.vehicleId.model || '')
                                        : '' %>

                                </div>


                                <div class="vehicle-number">

                                    Reg No:

                                    <%= booking.vehicleId
                                        ? (booking.vehicleId.vehicleNumber || 'N/A')
                                        : 'N/A' %>

                                </div>

                            </div>


                            <span class="vehicle-type">

                                <%= booking.vehicleId
                                    ? (booking.vehicleId.type || 'Vehicle')
                                    : 'Vehicle' %>

                            </span>


                        </div>


                        <!-- ================= BOOKING BODY ================= -->

                        <div class="card-body">


                            <!-- CUSTOMER -->

                            <div class="info">

                                <strong>
                                    Customer:
                                </strong>

                                <%= booking.userId
                                    ? (booking.userId.name || 'N/A')
                                    : 'N/A' %>

                            </div>


                            <!-- EMAIL -->

                            <div class="info">

                                <strong>
                                    Email:
                                </strong>

                                <%= booking.userId
                                    ? (booking.userId.email || 'N/A')
                                    : 'N/A' %>

                            </div>


                            <!-- START DATE -->

                            <div class="info">

                                <strong>
                                    Start Date:
                                </strong>

                                <%= booking.startDate
                                    ? booking.startDate.toLocaleDateString()
                                    : 'N/A' %>

                            </div>


                            <!-- END DATE -->

                            <div class="info">

                                <strong>
                                    End Date:
                                </strong>

                                <%= booking.endDate
                                    ? booking.endDate.toLocaleDateString()
                                    : 'N/A' %>

                            </div>


                            <!-- ================= AMOUNT ================= -->

                            <div class="amount">

                                ₹<%= booking.totalAmount || 0 %>

                            </div>


                            <!-- ================= BOOKING STATUS ================= -->

                            <span class="status <%= booking.status || 'pending' %>">

                                <%= booking.status
                                    ? booking.status.toUpperCase()
                                    : 'UNKNOWN' %>

                            </span>


                            <!-- ================= ACTIONS ================= -->

                            <% if (booking.status === 'pending') { %>


                                <div class="booking-actions">


                                    <!-- CONFIRM -->

                                    <form
                                        action="/owner/booking/<%= booking._id %>/confirm"
                                        method="POST"
                                    >

                                        <button
                                            type="submit"
                                            class="action-btn confirm-btn"
                                        >
                                            Confirm
                                        </button>

                                    </form>


                                    <!-- REJECT -->

                                    <form
                                        action="/owner/booking/<%= booking._id %>/reject"
                                        method="POST"
                                    >

                                        <button
                                            type="submit"
                                            class="action-btn reject-btn"
                                        >
                                            Reject
                                        </button>

                                    </form>

                                </div>

                            <% } %>


                            <!-- ================= PAYMENT ================= -->

                            <div class="payment">

                                Payment:

                                <% if (booking.paymentStatus === 'paid') { %>

                                    <strong class="payment-paid">
                                        PAID
                                    </strong>

                                <% } else { %>

                                    <strong class="payment-pending">
                                        PENDING
                                    </strong>

                                <% } %>

                            </div>


                            <!-- ================= EDGE CASE WARNING ================= -->

                            <% if (
                                booking.status === 'completed' &&
                                booking.paymentStatus !== 'paid'
                            ) { %>

                                <div
                                    style="
                                        margin-top: 12px;
                                        padding: 10px;
                                        background: #fee2e2;
                                        color: #991b1b;
                                        border-radius: 7px;
                                        font-size: 12px;
                                        font-weight: 600;
                                    "
                                >

                                    ⚠ Invalid booking state:
                                    Completed booking must have paid payment.

                                </div>

                            <% } %>


                        </div>

                    </div>


                <% }) %>


            </div>


        <% } else { %>


            <!-- ================= EMPTY / NO RESULTS ================= -->

            <div class="empty-state">


                <% if (
                    (typeof search !== 'undefined' && search) ||
                    (typeof status !== 'undefined' && status) ||
                    (typeof paymentStatus !== 'undefined' && paymentStatus)
                ) { %>


                    <h3>
                        No Matching Bookings
                    </h3>


                    <p>
                        No bookings match your selected filters.
                    </p>


                    <a
                        href="/owner/history"
                        class="reset-btn"
                    >
                        Clear Filters
                    </a>


                <% } else { %>


                    <h3>
                        No Booking History
                    </h3>


                    <p>
                        No bookings have been made for your vehicles yet.
                    </p>


                <% } %>


            </div>


        <% } %>


    </div>


</body>

</html>