<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Vehicles - Owner Dashboard</title>

    <link rel="stylesheet" href="/css/owner-vehicles.css">
</head>

</head>


<body>


    <!-- ================= HEADER ================= -->

    <header>

        <h1>
            <span>V</span>RS - Vehicle Rentals
        </h1>

        <div>

            <a href="/owner/dashboard" style="
                    color: #cbd5e1;
                    text-decoration: none;
                    font-size: 14px;
                ">
                ← Back to Dashboard
            </a>

        </div>

    </header>


    <div class="container">


        <!-- ================= TOP BAR ================= -->

        <div class="top-bar">

            <h2>
                My Vehicles
            </h2>

            <a href="/owner/vehicles/add" class="btn-add">
                + Add Vehicle
            </a>

        </div>


        <!-- ================= VEHICLES ================= -->

        <% if (vehicles && vehicles.length> 0) { %>

            <div class="grid">

                <% vehicles.forEach(vehicle=> { %>


                    <!-- ================= VEHICLE CARD ================= -->

                    <div class="card">


                        <!-- IMAGE -->

                        <div class="vehicle-image">

                            <% if (vehicle.image) { %>

                                <img src="<%= vehicle.image %>" alt="<%= vehicle.brand %> <%= vehicle.model %>">

                                <% } else { %>

                                    <div class="no-image">
                                        No Image Available
                                    </div>

                                    <% } %>

                        </div>


                        <!-- HEADER -->

                        <div class="card-header">

                            <div class="card-title">

                                <%= vehicle.brand %>
                                    <%= vehicle.model %>

                            </div>

                            <span class="badge-type">

                                <%= vehicle.type || 'Vehicle' %>

                            </span>

                        </div>


                        <!-- BODY -->

                        <div class="card-body">

                            <p>

                                <strong>
                                    Reg No:
                                </strong>

                                <%= vehicle.vehicleNumber %>

                            </p>


                            <p>

                                <strong>
                                    Type:
                                </strong>

                                <%= vehicle.type %>

                            </p>


                            <div class="price-tag">

                                ₹<%= vehicle.pricePerDay %>

                                    <span>
                                        / day
                                    </span>

                            </div>


                            <!-- STATUS -->

                            <div class="status
                                <%= vehicle.availability
                                    ? 'available'
                                    : 'unavailable'
                                %>">

                                Status:

                                <%= vehicle.availability ? 'Available for Rent' : 'Not Available' %>

                            </div>

                        </div>


                        <!-- ACTIONS -->

                        <div class="card-actions">


                            <a href="/owner/vehicles/edit/<%= vehicle._id %>" class="btn-edit">
                                Edit
                            </a>


                            <form action="/owner/vehicles/delete/<%= vehicle._id %>" method="POST" onsubmit="
                                    return confirm(
                                        'Are you sure you want to delete this vehicle?'
                                    );
                                ">
                                <button type="submit" class="btn-delete">
                                    Delete
                                </button>

                            </form>


                        </div>


                    </div>


                    <% }) %>

            </div>


            <% } else { %>


                <!-- ================= EMPTY STATE ================= -->

                <div class="empty-state">

                    <p>
                        No vehicles found.
                    </p>

                    <a href="/owner/vehicles/add" class="btn-add">
                        + Add Your First Vehicle
                    </a>

                </div>


                <% } %>


    </div>


</body>

</html>