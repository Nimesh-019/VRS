<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Vehicle Rental System</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="auth-body">

    <header>
        <h1><span>V</span>RS - Vehicle Rentals</h1>
    </header>

    <div class="auth-wrapper">
        <div class="auth-card">

            <h2>Welcome Back</h2>
            <p class="auth-subtitle">Login to access your account</p>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert-error">
                    <span>⚠️</span> <%= error %>
                </div>
            <% } %>

            <form action="/login" method="POST">

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="you@example.com"
                        value="<%= typeof email !== 'undefined' ? email : '' %>"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter your password"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="role">Login As</label>
                    <select id="role" name="role" required>
                        <option value="">Select your role</option>
                        <option value="user" <%= typeof role !== 'undefined' && role === 'user' ? 'selected' : '' %>>User (Customer)</option>
                        <option value="owner" <%= typeof role !== 'undefined' && role === 'owner' ? 'selected' : '' %>>Vehicle Owner</option>
                        <option value="admin" <%= typeof role !== 'undefined' && role === 'admin' ? 'selected' : '' %>>Admin</option>
                    </select>
                </div>

                <button type="submit" class="btn-primary btn-block">
                    Login →
                </button>

            </form>

            <div class="auth-footer">
                <p>Don't have an account? <a href="/signup">Create Account</a></p>
            </div>

        </div>
    </div>

</body>

</html>