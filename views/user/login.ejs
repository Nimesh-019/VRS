<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>VRS - Login</title>

    <link rel="stylesheet" href="/css/auth.css">
</head>

<body>

    <div class="auth-container">

        <!-- LEFT SIDE -->
        <div class="auth-banner">

            <div class="brand">
                <span>V</span>RS
            </div>

            <div class="banner-content">
                <p class="small-text">VEHICLE RENTAL SYSTEM</p>

                <h1>
                    Your journey<br>
                    starts <span>here.</span>
                </h1>

                <p>
                    Rent the perfect vehicle for your next adventure.
                    Fast, simple and reliable.
                </p>
            </div>

            <div class="banner-footer">
                <span>🚗 Easy Booking</span>
                <span>🛡️ Secure</span>
                <span>⚡ Fast</span>
            </div>

        </div>


        <!-- RIGHT SIDE -->
        <div class="auth-form-container">

            <div class="auth-form">

                <h2>Welcome Back</h2>

                <p class="subtitle">
                    Login to continue to your account
                </p>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #fca5a5; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                        <span>⚠️</span> <%= error %>
                    </div>
                <% } %>

                <form action="/login" method="POST">

                    <div class="input-group">

                        <label for="email">Email Address</label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="you@example.com"
                            value="<%= typeof email !== 'undefined' ? email : '' %>"
                            required
                        >

                    </div>


                    <div class="input-group">

                        <label for="password">Password</label>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Enter your password"
                            required
                        >

                    </div>


                    <div class="input-group">

                        <label for="role">Login As</label>

                        <select id="role" name="role" required>

                            <option value="">Select your role</option>

                            <option value="user" <%= typeof role !== 'undefined' && role === 'user' ? 'selected' : '' %>>
                                User
                            </option>

                            <option value="owner" <%= typeof role !== 'undefined' && role === 'owner' ? 'selected' : '' %>>
                                Vehicle Owner
                            </option>

                            <option value="admin" <%= typeof role !== 'undefined' && role === 'admin' ? 'selected' : '' %>>
                                Admin
                            </option>

                        </select>

                    </div>


                    <button type="submit" class="auth-button">
                        Login
                        <span>→</span>
                    </button>

                </form>


                <div class="divider">
                    <span>OR</span>
                </div>


                <p class="switch-page">
                    Don't have an account?
                    <a href="/signup">Create Account</a>
                </p>

            </div>

        </div>

    </div>

</body>

</html>