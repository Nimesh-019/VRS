<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Customer Dashboard - Vehicle Rental System</title>


    <link rel="stylesheet" href="/css/user-dashboard.css">
</head>


<body>


    <!-- ================= HEADER ================= -->

    <header>

        <h1>

            <span>V</span>RS - Vehicle Rentals

        </h1>


        <div class="user-nav">

            <span>

                Welcome,

                <strong>
                    <%= user.name %>
                </strong>

                (Customer)

            </span>


            <a
                href="/bookings"
                class="bookings-btn"
            >
                My Bookings
            </a>


            <a
                href="/logout"
                class="logout-btn"
            >
                Logout
            </a>

        </div>

    </header>



    <!-- ================= MAIN ================= -->

    <div class="container">


        <!-- ================= SECTION HEADER ================= -->

        <div class="section-header">

            <h2>
                Vehicles Available for Rent
            </h2>

            <p>
                Browse vehicles listed by owners and book the one you need.
            </p>

        </div>



        <!-- ================= SEARCH & FILTER ================= -->

        <div class="filter-box">

            <form
                action="/user/dashboard"
                method="GET"
                class="filter-form"
            >


                <!-- SEARCH -->

                <input
                    type="text"
                    name="search"
                    placeholder="🔍 Search brand, model or registration no."
                    value="<%= search || '' %>"
                >



                <!-- VEHICLE TYPE -->

                <select name="type">

                    <option value="">
                        All Types
                    </option>


                    <option
                        value="Car"
                        <%= type === 'Car' ? 'selected' : '' %>
                    >
                        Car
                    </option>


                    <option
                        value="Bike"
                        <%= type === 'Bike' ? 'selected' : '' %>
                    >
                        Bike
                    </option>


                    <option
                        value="Scooter"
                        <%= type === 'Scooter' ? 'selected' : '' %>
                    >
                        Scooter
                    </option>


                    <option
                        value="SUV"
                        <%= type === 'SUV' ? 'selected' : '' %>
                    >
                        SUV
                    </option>


                    <option
                        value="Other"
                        <%= type === 'Other' ? 'selected' : '' %>
                    >
                        Other
                    </option>

                </select>



                <!-- MINIMUM PRICE -->

                <input
                    type="number"
                    name="minPrice"
                    placeholder="Min ₹ / day"
                    min="0"
                    value="<%= minPrice || '' %>"
                >



                <!-- MAXIMUM PRICE -->

                <input
                    type="number"
                    name="maxPrice"
                    placeholder="Max ₹ / day"
                    min="0"
                    value="<%= maxPrice || '' %>"
                >



                <!-- SORT -->

                <select name="sort">

                    <option value="">
                        Sort By
                    </option>


                    <option
                        value="priceLow"
                        <%= sort === 'priceLow' ? 'selected' : '' %>
                    >
                        Price: Low → High
                    </option>


                    <option
                        value="priceHigh"
                        <%= sort === 'priceHigh' ? 'selected' : '' %>
                    >
                        Price: High → Low
                    </option>

                </select>



                <!-- SEARCH BUTTON -->

                <button
                    type="submit"
                    class="search-btn"
                >
                    Search
                </button>



                <!-- CLEAR BUTTON -->

                <a
                    href="/user/dashboard"
                    class="clear-btn"
                >
                    Clear
                </a>


            </form>

        </div>



        <!-- ================= RESULTS COUNT ================= -->

        <% if (vehicles && vehicles.length > 0) { %>

            <div class="results-info">

                Showing
                <strong><%= vehicles.length %></strong>
                vehicle<%= vehicles.length === 1 ? '' : 's' %>

            </div>

        <% } %>



        <!-- ================= VEHICLES ================= -->

        <% if (vehicles && vehicles.length > 0) { %>


            <div class="grid">


                <% vehicles.forEach(vehicle => { %>


                    <!-- ================= VEHICLE CARD ================= -->

                    <div class="card">


                        <!-- IMAGE -->

                        <div class="vehicle-image">


                            <% if (vehicle.image) { %>

                                <img
                                    src="<%= vehicle.image %>"
                                    alt="<%= vehicle.brand %> <%= vehicle.model %>"
                                >

                            <% } else { %>

                                <div class="no-image">
                                    No Image Available
                                </div>

                            <% } %>


                        </div>



                        <!-- CARD HEADER -->

                        <div class="card-header">


                            <div class="card-title">

                                <%= vehicle.brand %>
                                <%= vehicle.model %>

                            </div>


                            <span class="badge-type">

                                <%= vehicle.type || 'Vehicle' %>

                            </span>


                        </div>



                        <!-- CARD BODY -->

                        <div class="card-body">


                            <!-- VEHICLE NUMBER -->

                            <div class="vehicle-num">

                                Reg No:

                                <%= vehicle.vehicleNumber %>

                            </div>



                            <!-- PRICE -->

                            <div class="price-tag">

                                ₹<%= vehicle.pricePerDay %>

                                <span>
                                    / day
                                </span>

                            </div>



                            <!-- DESCRIPTION -->

                            <% if (vehicle.description) { %>

                                <p class="description">

                                    <%= vehicle.description %>

                                </p>

                            <% } %>



                            <!-- OWNER -->

                            <div class="owner-box">


                                <strong>
                                    Owner Details
                                </strong>


                                <% if (vehicle.ownerId) { %>


                                    <p>
                                        👤 <%= vehicle.ownerId.name %>
                                    </p>


                                    <p>
                                        📧 <%= vehicle.ownerId.email %>
                                    </p>


                                    <p>
                                        📞 <%= vehicle.ownerId.phone %>
                                    </p>


                                <% } else { %>

                                    <p>
                                        Owner info unavailable
                                    </p>

                                <% } %>


                            </div>


                        </div>



                        <!-- CARD FOOTER -->

                        <div class="card-footer">


                            <% if (vehicle.availability) { %>


                                <span class="status-available">

                                    ✓ Available for Rent

                                </span>


                                <a
                                    href="/book/<%= vehicle._id %>"
                                    class="book-btn"
                                >
                                    Book Now
                                </a>


                            <% } else { %>


                                <span class="status-unavailable">

                                    ✗ Currently Rented

                                </span>


                            <% } %>


                        </div>


                    </div>


                <% }) %>


            </div>



        <% } else { %>


            <!-- ================= EMPTY STATE ================= -->

            <div class="empty-state">


                <h3>
                    No Vehicles Found
                </h3>


                <% if (search || type || minPrice || maxPrice || sort) { %>

                    <p>
                        No vehicles match your current search or filter.
                        Try changing your filters.
                    </p>

                <% } else { %>

                    <p>
                        There are currently no vehicles listed by owners.
                        Please check back later!
                    </p>

                <% } %>


            </div>


        <% } %>


    </div>


</body>

</html>