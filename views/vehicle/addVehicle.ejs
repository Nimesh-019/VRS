
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Register Vehicle | Vehicle Rental System</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gray-100 flex items-center justify-center p-6">

    <div class="bg-white shadow-xl rounded-2xl w-full max-w-lg p-8">

        <!-- Heading -->
        <h1 class="text-3xl font-bold text-center text-blue-700 mb-2">
            Vehicle Rental System
        </h1>

        <p class="text-center text-gray-500 mb-8">
            Register New Vehicle
        </p>


        <!-- Vehicle Registration Form -->
            <form action="/vehicles/add" method="POST" class="space-y-5">

            <!-- Vehicle Number -->
            <div>
                <label for="vehicleNumber" class="block font-semibold mb-2">
                    Vehicle Number
                </label>

                <input
                    type="text"
                    id="vehicleNumber"
                    name="vehicleNumber"
                    placeholder="GJ05AB1234"
                    required
                    class="w-full border border-gray-300 rounded-lg p-3
                           focus:ring-2 focus:ring-blue-500
                           focus:border-blue-500 outline-none">
            </div>


            <!-- Vehicle Name -->
            <div>
                <label for="vehicleName" class="block font-semibold mb-2">
                    Vehicle Name
                </label>

                <input
                    type="text"
                    id="vehicleName"
                    name="vehicleName"
                    placeholder="Activa 6G"
                    required
                    class="w-full border border-gray-300 rounded-lg p-3
                           focus:ring-2 focus:ring-blue-500
                           focus:border-blue-500 outline-none">
            </div>


            <!-- Owner Name -->
            <div>
                <label for="ownerName" class="block font-semibold mb-2">
                    Owner Name
                </label>

                <input
                    type="text"
                    id="ownerName"
                    name="ownerName"
                    placeholder="Nimesh Khandhar"
                    required
                    class="w-full border border-gray-300 rounded-lg p-3
                           focus:ring-2 focus:ring-blue-500
                           focus:border-blue-500 outline-none">
            </div>


            <!-- Mobile Number -->
            <div>
                <label for="mobileNumber" class="block font-semibold mb-2">
                    Mobile Number
                </label>

                <input
                    type="tel"
                    id="mobileNumber"
                    name="mobileNumber"
                    placeholder="9876543210"
                    pattern="[0-9]{10}"
                    maxlength="10"
                    required
                    class="w-full border border-gray-300 rounded-lg p-3
                           focus:ring-2 focus:ring-blue-500
                           focus:border-blue-500 outline-none">
            </div>


            <!-- Rent Per Day -->
            <div>
                <label for="rentPerDay" class="block font-semibold mb-2">
                    Rent Per Day (₹)
                </label>

                <input
                    type="number"
                    id="rentPerDay"
                    name="rentPerDay"
                    placeholder="500"
                    min="1"
                    required
                    class="w-full border border-gray-300 rounded-lg p-3
                           focus:ring-2 focus:ring-blue-500
                           focus:border-blue-500 outline-none">
            </div>


            <!-- Submit Button -->
            <button
                type="submit"
                class="w-full bg-blue-700 text-white py-3 rounded-lg
                       font-semibold hover:bg-blue-800
                       transition duration-200">

                Register Vehicle

            </button>

        </form>

    </div>

</body>

</html>

