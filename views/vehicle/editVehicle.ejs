<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Edit Vehicle</title>

    <link rel="stylesheet" href="/output.css">

</head>


<body class="bg-gray-100 min-h-screen flex justify-center items-center p-6">


    <div class="bg-white shadow-xl rounded-2xl w-full max-w-lg p-8">


        <h1 class="text-3xl font-bold text-center text-blue-700 mb-2">

            Edit Vehicle

        </h1>


        <p class="text-center text-gray-500 mb-8">

            Update Vehicle Information

        </p>


        <form
            action="/vehicles/edit/<%= vehicle.id %>"
            method="POST"
            class="space-y-5">


            <div>

                <label class="block font-semibold mb-2">
                    Vehicle Number
                </label>

                <input
                    type="text"
                    name="vehicleNumber"
                    value="<%= vehicle.vehicleNumber %>"
                    required
                    class="w-full border rounded-lg p-3">

            </div>


            <div>

                <label class="block font-semibold mb-2">
                    Vehicle Name
                </label>

                <input
                    type="text"
                    name="vehicleName"
                    value="<%= vehicle.vehicleName %>"
                    required
                    class="w-full border rounded-lg p-3">

            </div>


            <div>

                <label class="block font-semibold mb-2">
                    Owner Name
                </label>

                <input
                    type="text"
                    name="ownerName"
                    value="<%= vehicle.ownerName %>"
                    required
                    class="w-full border rounded-lg p-3">

            </div>


            <div>

                <label class="block font-semibold mb-2">
                    Mobile Number
                </label>

                <input
                    type="tel"
                    name="mobileNumber"
                    value="<%= vehicle.mobileNumber %>"
                    required
                    class="w-full border rounded-lg p-3">

            </div>


            <div>

                <label class="block font-semibold mb-2">
                    Rent Per Day
                </label>

                <input
                    type="number"
                    name="rentPerDay"
                    value="<%= vehicle.rentPerDay %>"
                    required
                    class="w-full border rounded-lg p-3">

            </div>


            <button
                type="submit"
                class="w-full bg-blue-700 hover:bg-blue-800 text-white py-3 rounded-lg">

                Update Vehicle

            </button>


        </form>

    </div>

</body>

</html>